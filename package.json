{
  "name": "dsh-peak-brief",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 峰谷调度插件：高峰前 N 分钟自动生成仅供 AI 恢复用的简报并停自动续跑，高峰硬拦模型请求（带逃生），闲时自动注入简报继续任务。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "scripts",
    "data",
    "test",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test",
    "accept": "node scripts/acceptance.mjs",
    "build:holidays": "node scripts/build-holidays.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "peak-hours",
    "off-peak",
    "scheduling"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinttt233/dsh-peak-brief.git"
  },
  "homepage": "https://github.com/rinttt233/dsh-peak-brief#readme",
  "bugs": {
    "url": "https://github.com/rinttt233/dsh-peak-brief/issues"
  },
  "author": "rinttt233",
  "license": "MIT"
}
